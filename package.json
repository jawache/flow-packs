{
  "name": "@jawache/flow-packs",
  "description": "Packs of guardrails and breadcrumbs for flow: git, justfile, node, secrets, typescript, tdd, fcis, docs and work.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jawache/flow-packs.git"
  },
  "exports": {
    "./docs": {
      "types": "./dist/types/docs.d.ts",
      "default": "./dist/docs.mjs"
    },
    "./fcis": {
      "types": "./dist/types/fcis.d.ts",
      "default": "./dist/fcis.mjs"
    },
    "./git": {
      "types": "./dist/types/git.d.ts",
      "default": "./dist/git.mjs"
    },
    "./justfile": {
      "types": "./dist/types/justfile.d.ts",
      "default": "./dist/justfile.mjs"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "default": "./dist/node.mjs"
    },
    "./secrets": {
      "types": "./dist/types/secrets.d.ts",
      "default": "./dist/secrets.mjs"
    },
    "./tdd": {
      "types": "./dist/types/tdd.d.ts",
      "default": "./dist/tdd.mjs"
    },
    "./typescript": {
      "types": "./dist/types/typescript.d.ts",
      "default": "./dist/typescript.mjs"
    },
    "./work": {
      "types": "./dist/types/work.d.ts",
      "default": "./dist/work.mjs"
    }
  },
  "files": [
    "dist/*.mjs",
    "dist/types/",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@jawache/flow": ">=0.4.0 <0.5.0"
  },
  "peerDependenciesMeta": {
    "@jawache/flow": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "//": "Commands live in the justfile — run `just`."
  },
  "devDependencies": {
    "@jawache/flow": "github:jawache/flow#v0.4.0",
    "@types/node": "24.13.4",
    "commit-and-tag-version": "13.1.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "version": "0.1.3"
}
